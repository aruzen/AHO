#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; }
result;
layout(set = 0, binding = 1) uniform texture2D image_data;
layout(set = 0, binding = 2) uniform sampler image_sampler;
void main() {
    vec4 color = textureLod(sampler2D(image_data, image_sampler), vec2(0.5), 0);
    result.values[0] = uint(round(color.r * 255));
    result.values[1] = uint(round(color.g * 255));
}
