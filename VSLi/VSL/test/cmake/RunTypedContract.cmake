include("${TEST_ENVIRONMENT}")
set(arguments)
if(TEST_COMPILER_ID STREQUAL "MSVC" OR TEST_FRONTEND STREQUAL "MSVC")
    list(APPEND arguments /nologo /EHsc /std:c++latest /permissive- /Zc:preprocessor /utf-8 /DNOMINMAX /Zs "/DVSL_TYPED_CASE=${TEST_CASE}")
    foreach(directory IN LISTS TEST_INCLUDE_DIRS)
        list(APPEND arguments "/I${directory}")
    endforeach()
else()
    separate_arguments(flags NATIVE_COMMAND "${TEST_FLAGS}")
    list(APPEND arguments ${flags} -std=c++2c -fsyntax-only "-DVSL_TYPED_CASE=${TEST_CASE}")
    if(TEST_SYSROOT)
        list(APPEND arguments -isysroot "${TEST_SYSROOT}")
    endif()
    foreach(arch IN LISTS TEST_ARCHITECTURES)
        list(APPEND arguments -arch "${arch}")
    endforeach()
    foreach(directory IN LISTS TEST_INCLUDE_DIRS)
        list(APPEND arguments "-I${directory}")
    endforeach()
endif()
execute_process(COMMAND "${TEST_COMPILER}" ${arguments} "${TEST_SOURCE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 45)
if(TEST_CASE EQUAL 0)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Valid typed pipeline did not compile:\n${output}\n${errors}")
    endif()
else()
    if(result EQUAL 0)
        message(FATAL_ERROR "Invalid typed pipeline case ${TEST_CASE} compiled successfully")
    endif()
    if(DEFINED TEST_EXPECTED)
        set(expected "${TEST_EXPECTED}")
    elseif(TEST_CASE LESS 3)
        set(expected "bind_vertices")
    elseif(TEST_CASE EQUAL 3)
        set(expected "TypedVertexBuffer")
    elseif(TEST_CASE EQUAL 11 OR TEST_CASE EQUAL 14 OR TEST_CASE EQUAL 15)
        set(expected "Vertex member format")
    elseif(TEST_CASE EQUAL 12)
        set(expected "different record")
    elseif(TEST_CASE EQUAL 13)
        set(expected "Vertex record location overflow")
    elseif(TEST_CASE EQUAL 8)
        set(expected "explicit offsetof")
    else()
        set(expected "Invalid typed vertex layout")
    endif()
    set(diagnostics "${errors}${output}")
    if(TEST_COMPILER_ID STREQUAL "MSVC" OR TEST_FRONTEND STREQUAL "MSVC")
        # MSVC installations may have only a localized language pack. Preserve
        # the reason checks using equivalent, language-independent diagnostic IDs.
        string(REPLACE "error C2131:" "error C2131: constant expression:" diagnostics "${diagnostics}")
        string(REPLACE "error C3490:" "error C3490: const-qualified:" diagnostics "${diagnostics}")
        string(REPLACE "error C2280:" "error C2280: deleted:" diagnostics "${diagnostics}")
    endif()
    if(NOT "${diagnostics}" MATCHES "${expected}")
        message(FATAL_ERROR "Compilation failed for an unexpected reason:\n${output}\n${errors}")
    endif()
endif()
