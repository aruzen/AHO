include_guard(GLOBAL)

function(vsl_generate_buffer_layout)
    include(CheckTypeSize)
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
    set(CMAKE_REQUIRED_INCLUDES "${VSL_HOME}/src/private" "${VSL_HOME}/include" ${Vulkan_INCLUDE_DIRS} ${GLFW_INCLUDE_DIRS})
    set(CMAKE_EXTRA_INCLUDE_FILES "VSL/vulkan/_pimpls.hpp" "VSL/sync/resource_use_state.hpp" "VSL/storage/buffer_abi.hpp")
    if(WIN32)
        set(CMAKE_REQUIRED_DEFINITIONS -DNOMINMAX -DWIN32_LEAN_AND_MEAN -DGLFW_DLL)
    endif()
    if(CMAKE_OSX_ARCHITECTURES MATCHES ";")
        message(FATAL_ERROR "Buffer placement currently requires a single target architecture")
    endif()
    file(SHA256 "${VSL_HOME}/src/private/VSL/vulkan/_pimpls.hpp" state_hash)
    file(SHA256 "${VSL_HOME}/src/private/VSL/lifetime/buffer_storage.hpp" buffer_slot_hash)
    file(SHA256 "${VSL_HOME}/src/private/VSL/lifetime/image_storage.hpp" image_slot_hash)
    file(SHA256 "${VSL_HOME}/src/private/VSL/lifetime/sampler_storage.hpp" sampler_slot_hash)
    file(SHA256 "${VSL_HOME}/src/private/VSL/lifetime/descriptor_storage.hpp" descriptor_slot_hash)
    file(SHA256 "${VSL_HOME}/src/private/VSL/lifetime/shader_storage.hpp" shader_slot_hash)
    file(SHA256 "${VSL_HOME}/src/private/VSL/lifetime/pipeline_layout_storage.hpp" pipeline_layout_slot_hash)
    file(SHA256 "${VSL_HOME}/src/private/VSL/lifetime/render_pass_storage.hpp" render_pass_slot_hash)
    file(SHA256 "${VSL_HOME}/src/private/VSL/lifetime/pipeline_storage.hpp" pipeline_slot_hash)
    file(SHA256 "${VSL_HOME}/src/private/VSL/lifetime/descriptor_bindings.hpp" descriptor_owner_hash)
    file(SHA256 "${VSL_HOME}/src/private/VSL/lifetime/owner_access.hpp" owner_access_hash)
    file(SHA256 "${VSL_HOME}/include/VSL/sync/resource_use_state.hpp" use_hash)
    file(SHA256 "${VSL_HOME}/include/VSL/sync/completion.hpp" completion_hash)
    file(SHA256 "${VSL_HOME}/include/VSL/lifetime/resource_use.hpp" lifetime_hash)
    file(SHA256 "${Vulkan_INCLUDE_DIRS}/vulkan/vulkan_core.h" vulkan_hash)
    file(SHA256 "${Vulkan_INCLUDE_DIRS}/vulkan/vulkan.hpp" vulkan_cpp_hash)
    file(SHA256 "${VSL_HOME}/include/VSL/storage/buffer_abi.hpp" abi_mode_hash)
    file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/buffer_layout.hpp.in" template_hash)
    set(public_layout_hashes "")
    foreach(api IN ITEMS lifetime/resource_id.hpp lifetime/resource_plan.hpp lifetime/resource_arena.hpp lifetime/logical_use_state.hpp
            lifetime/owner_ref.hpp lifetime/dependency_node.hpp
            lifetime/buffer_view.hpp storage/resource_layout.hpp storage/arena_memory.hpp operation/buffer_create_info.hpp
            operation/image_create_info.hpp operation/sampler_create_info.hpp operation/descriptor_create_info.hpp operation/shader_create_info.hpp operation/pipeline_layout_create_info.hpp operation/render_pass_description.hpp operation/graphics_pipeline_state.hpp
            vulkan/buffer_and_image_accessor.hpp vulkan/sampler.hpp vulkan/descriptor.hpp vulkan/shader.hpp vulkan/pipeline_layout.hpp vulkan/render_pass.hpp vulkan/pipeline.hpp)
        file(SHA256 "${VSL_HOME}/include/VSL/${api}" api_hash)
        string(APPEND public_layout_hashes ";${api_hash}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${VSL_HOME}/include/VSL/${api}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${VSL_HOME}/src/private/VSL/vulkan/_pimpls.hpp" "${VSL_HOME}/include/VSL/sync/resource_use_state.hpp"
        "${VSL_HOME}/include/VSL/sync/completion.hpp" "${VSL_HOME}/include/VSL/lifetime/resource_use.hpp"
        "${VSL_HOME}/include/VSL/storage/buffer_abi.hpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${VSL_HOME}/src/private/VSL/lifetime/buffer_storage.hpp"
        "${VSL_HOME}/src/private/VSL/lifetime/image_storage.hpp"
        "${VSL_HOME}/src/private/VSL/lifetime/sampler_storage.hpp"
        "${VSL_HOME}/src/private/VSL/lifetime/descriptor_storage.hpp"
        "${VSL_HOME}/src/private/VSL/lifetime/shader_storage.hpp"
        "${VSL_HOME}/src/private/VSL/lifetime/pipeline_layout_storage.hpp"
        "${VSL_HOME}/src/private/VSL/lifetime/render_pass_storage.hpp"
        "${VSL_HOME}/src/private/VSL/lifetime/pipeline_storage.hpp"
        "${VSL_HOME}/src/private/VSL/lifetime/descriptor_bindings.hpp"
        "${VSL_HOME}/src/private/VSL/lifetime/owner_access.hpp"
        "${Vulkan_INCLUDE_DIRS}/vulkan/vulkan_core.h" "${Vulkan_INCLUDE_DIRS}/vulkan/vulkan.hpp")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/generated/include")
    if(CMAKE_CONFIGURATION_TYPES)
        set(configurations ${CMAKE_CONFIGURATION_TYPES})
    elseif(CMAKE_BUILD_TYPE)
        set(configurations ${CMAKE_BUILD_TYPE})
    else()
        set(configurations Unspecified)
    endif()
    foreach(configuration IN LISTS configurations)
        string(TOUPPER "${configuration}" upper)
        set(CMAKE_TRY_COMPILE_CONFIGURATION "${configuration}")
        string(SHA256 input_hash "10;${pipeline_slot_hash};${render_pass_slot_hash};${pipeline_layout_slot_hash};${shader_slot_hash};${owner_access_hash};${state_hash};${buffer_slot_hash};${image_slot_hash};${sampler_slot_hash};${descriptor_slot_hash};${descriptor_owner_hash};${use_hash};${completion_hash};${lifetime_hash};${vulkan_hash};${vulkan_cpp_hash};${abi_mode_hash};${template_hash};${public_layout_hashes};${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_CXX_COMPILER_TARGET};${CMAKE_CXX_COMPILER_FRONTEND_VARIANT};${CMAKE_SYSTEM_NAME};${CMAKE_SYSTEM_VERSION};${CMAKE_SYSTEM_PROCESSOR};${CMAKE_OSX_ARCHITECTURES};${CMAKE_OSX_DEPLOYMENT_TARGET};${CMAKE_SIZEOF_VOID_P};${CMAKE_CXX_FLAGS};${CMAKE_CXX_FLAGS_${upper}};${CMAKE_MSVC_RUNTIME_LIBRARY};${CMAKE_OSX_SYSROOT};${CMAKE_SYSROOT};${configuration}")
        foreach(kind IN ITEMS BUFFER_IMPL IMAGE_IMPL SAMPLER_IMPL DESCRIPTOR_LAYOUT_IMPL DESCRIPTOR_POOL_IMPL DESCRIPTOR_SET_IMPL SHADER_IMPL PIPELINE_LAYOUT_IMPL RENDER_PASS_IMPL PIPELINE_IMPL BUFFER_USE)
            if(kind STREQUAL BUFFER_IMPL)
                set(type "vsl::impl::BufferImpl")
            elseif(kind STREQUAL IMAGE_IMPL)
                set(type "vsl::impl::ImageImpl")
            elseif(kind STREQUAL SAMPLER_IMPL)
                set(type "vsl::impl::SamplerImpl")
            elseif(kind STREQUAL DESCRIPTOR_LAYOUT_IMPL)
                set(type "vsl::impl::ResourceBindingLayoutImpl")
            elseif(kind STREQUAL DESCRIPTOR_POOL_IMPL)
                set(type "vsl::impl::GraphicResourcePoolImpl")
            elseif(kind STREQUAL DESCRIPTOR_SET_IMPL)
                set(type "vsl::impl::GraphicResourceImpl")
            elseif(kind STREQUAL SHADER_IMPL)
                set(type "vsl::impl::ShaderImpl")
            elseif(kind STREQUAL PIPELINE_LAYOUT_IMPL)
                set(type "vsl::impl::PipelineLayoutImpl")
            elseif(kind STREQUAL RENDER_PASS_IMPL)
                set(type "vsl::impl::RenderPassImpl")
            elseif(kind STREQUAL PIPELINE_IMPL)
                set(type "vsl::impl::PipelineImpl")
            else()
                set(type "vsl::ResourceUseState")
            endif()
            set(size_key "VSL_${kind}_SIZE_${input_hash}")
            set(align_key "VSL_${kind}_ALIGN_${input_hash}")
            check_type_size("${type}" "${size_key}" BUILTIN_TYPES_ONLY LANGUAGE CXX)
            check_type_size("char[alignof(${type})]" "${align_key}" BUILTIN_TYPES_ONLY LANGUAGE CXX)
            if(NOT ${size_key} OR NOT ${align_key})
                message(FATAL_ERROR "Cannot generate exact ${kind} layout for ${configuration}")
            endif()
            set(${kind}_SIZE "${${size_key}}")
            set(${kind}_ALIGNMENT "${${align_key}}")
        endforeach()
        set(mode_key "VSL_CPP_MODE_${input_hash}")
        check_type_size("char[vsl::storage::BUFFER_CPP_ABI_MODE]" "${mode_key}" BUILTIN_TYPES_ONLY LANGUAGE CXX)
        if(NOT ${mode_key})
            message(FATAL_ERROR "Unsupported C++ standard library ABI for Buffer placement")
        endif()
        set(cpp_mode "${${mode_key}}")
        string(REGEX MATCH "^[0-9]+" compiler_major "${CMAKE_CXX_COMPILER_VERSION}")
        if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
            set(compiler_guard "#if !defined(__clang__) || __clang_major__ != ${compiler_major}\n#error Buffer placement compiler ABI mismatch\n#endif\n")
        elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
            set(compiler_guard "#if defined(__clang__) || !defined(__GNUC__) || __GNUC__ != ${compiler_major}\n#error Buffer placement compiler ABI mismatch\n#endif\n")
        elseif(MSVC)
            set(compiler_guard "#if !defined(_MSC_VER) || _MSC_VER != ${MSVC_VERSION}\n#error Buffer placement compiler ABI mismatch\n#endif\n")
        else()
            message(FATAL_ERROR "Unsupported Buffer placement compiler")
        endif()
        string(SHA256 abi_hash "${input_hash};${BUFFER_IMPL_SIZE};${BUFFER_IMPL_ALIGNMENT};${IMAGE_IMPL_SIZE};${IMAGE_IMPL_ALIGNMENT};${SAMPLER_IMPL_SIZE};${SAMPLER_IMPL_ALIGNMENT};${DESCRIPTOR_LAYOUT_IMPL_SIZE};${DESCRIPTOR_LAYOUT_IMPL_ALIGNMENT};${DESCRIPTOR_POOL_IMPL_SIZE};${DESCRIPTOR_POOL_IMPL_ALIGNMENT};${DESCRIPTOR_SET_IMPL_SIZE};${DESCRIPTOR_SET_IMPL_ALIGNMENT};${SHADER_IMPL_SIZE};${SHADER_IMPL_ALIGNMENT};${PIPELINE_LAYOUT_IMPL_SIZE};${PIPELINE_LAYOUT_IMPL_ALIGNMENT};${RENDER_PASS_IMPL_SIZE};${RENDER_PASS_IMPL_ALIGNMENT};${PIPELINE_IMPL_SIZE};${PIPELINE_IMPL_ALIGNMENT};${BUFFER_USE_SIZE};${BUFFER_USE_ALIGNMENT};${cpp_mode}")
        string(SUBSTRING "${abi_hash}" 0 16 abi)
        set(header "VSL/generated/buffer_layout_${abi_hash}.hpp")
        file(MAKE_DIRECTORY "${output}/VSL/generated")
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/buffer_layout.hpp.in" "${output}/${header}" @ONLY)
        if(CMAKE_CONFIGURATION_TYPES)
            target_compile_definitions(VSL PUBLIC "$<$<CONFIG:${configuration}>:VSL_BUFFER_LAYOUT_HEADER=\"${header}\">")
            install(FILES "${output}/${header}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/VSL/generated" CONFIGURATIONS "${configuration}")
        else()
            target_compile_definitions(VSL PUBLIC "VSL_BUFFER_LAYOUT_HEADER=\"${header}\"")
            install(FILES "${output}/${header}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/VSL/generated")
        endif()
    endforeach()
    target_include_directories(VSL PUBLIC "$<BUILD_INTERFACE:${output}>")
endfunction()
