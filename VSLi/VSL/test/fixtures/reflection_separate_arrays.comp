#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer Output { vec4 value; }
result;
layout(set = 0, binding = 1) uniform texture2D image_data[2];
layout(set = 0, binding = 2) uniform sampler image_samplers[3];
void main() {
    result.value = textureLod(sampler2D(image_data[1], image_samplers[2]), vec2(0.5), 0);
}
