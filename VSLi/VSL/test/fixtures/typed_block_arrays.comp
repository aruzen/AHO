#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer Arrays {
    uint count;
    float weights[3];
    vec2 points[2][3];
    mat2 transforms[2];
    layout(row_major) mat2x3 rows;
    layout(column_major) mat3x2 columns;
} data;
void main() {
    data.count += uint(data.weights[2] + data.points[1][2].y + data.transforms[1][0][1] + data.rows[1][2] + data.columns[2][1]);
}
