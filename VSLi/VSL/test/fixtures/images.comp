#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; };
layout(set = 0, binding = 1, rgba8) readonly uniform image2D storage_image;
layout(set = 0, binding = 2) uniform sampler2D sampled_image;
void main() {
    values[0] = uint(round(imageLoad(storage_image, ivec2(0)).r * 255.0));
    values[1] = uint(round(texture(sampled_image, vec2(0.5)).g * 255.0));
}
