#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } output_data;
layout(push_constant) uniform Push { uint first; uint value; } push_data;
void main() {
    uint index = gl_GlobalInvocationID.x;
    output_data.values[push_data.first + index] = push_data.value + index;
}
