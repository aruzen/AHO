#version 450
// Reflection-only: array-of-arrays SPIR-V is never submitted to a Vulkan device.
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform sampler2D textures[65536][65536];
layout(set=0,binding=1) buffer Data { vec4 value; } data;
void main() { data.value = texture(textures[0][0], vec2(0)); }
