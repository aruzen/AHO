include("${TEST_ENVIRONMENT}")
separate_arguments(driver_flags NATIVE_COMMAND "${TEST_FLAGS}")
if(TEST_COMPILER_ID STREQUAL "MSVC")
    set(arguments /nologo /std:c++latest /Zs)
    set(include_prefix /I)
    set(definition_prefix /D)
else()
    set(arguments -std=c++23 -fsyntax-only -Werror=return-type)
    if(TEST_COMPILER_ID MATCHES "Clang")
        list(APPEND arguments -ferror-limit=0)
    endif()
    set(include_prefix -I)
    set(definition_prefix -D)
endif()
list(PREPEND arguments ${driver_flags} ${TEST_COMPILE_OPTIONS})
if(APPLE AND TEST_SYSROOT)
    list(APPEND arguments -isysroot "${TEST_SYSROOT}")
endif()
if(APPLE)
    foreach(architecture IN LISTS TEST_ARCHITECTURES)
        list(APPEND arguments -arch "${architecture}")
    endforeach()
endif()
foreach(directory IN LISTS TEST_INCLUDE_DIRS)
    list(APPEND arguments "${include_prefix}${directory}")
endforeach()
foreach(definition IN LISTS TEST_DEFINITIONS)
    list(APPEND arguments "${definition_prefix}${definition}")
endforeach()
if(TEST_EXTRA_DEFINITION)
    list(APPEND arguments "${definition_prefix}${TEST_EXTRA_DEFINITION}")
endif()
execute_process(COMMAND "${TEST_COMPILER}" ${arguments} "${TEST_SOURCE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 50)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "The public API must compile, but the compiler returned ${result}.\n${output}${errors}")
endif()
