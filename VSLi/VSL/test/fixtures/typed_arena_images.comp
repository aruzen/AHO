#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } result;
layout(set = 0, binding = 1) uniform sampler2D combined;
layout(set = 0, binding = 2) uniform texture2D separate_image;
layout(set = 0, binding = 3) uniform sampler separate_sampler;
void main() {
    result.values[0] = uint(round(textureLod(combined, vec2(0.5), 0).r * 255));
    result.values[1] = uint(round(textureLod(sampler2D(separate_image, separate_sampler), vec2(0.5), 0).g * 255));
}
